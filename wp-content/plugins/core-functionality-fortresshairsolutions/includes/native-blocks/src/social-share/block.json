{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pwire/social-share",
	"version": "1.0.0",
	"title": "Social Share",
	"category": "widgets",
	"icon": "share",
	"description": "Simple social share icon links.",
	"keywords": [ "social", "share", "icons" ],
	"textdomain": "pwire",
	"attributes": {
		"showEmail": { "type": "boolean", "default": true },
		"showFacebook": { "type": "boolean", "default": true },
		"showX": { "type": "boolean", "default": true },
		"showLinkedIn": { "type": "boolean", "default": true },
		"showWhatsApp": { "type": "boolean", "default": true },
		"iconColor": { "type": "string" },
		"customIconColor": { "type": "string" },
		"iconColorValue": { "type": "string" },
		"iconBackgroundColor": { "type": "string" },
		"customIconBackgroundColor": { "type": "string" },
		"iconBackgroundColorValue": { "type": "string" },
		"size": { "type": "string" }
	},
	"providesContext": {
		"pwire/iconColor": "iconColor",
		"pwire/iconColorValue": "iconColorValue",
		"pwire/iconBackgroundColor": "iconBackgroundColor",
		"pwire/iconBackgroundColorValue": "iconBackgroundColorValue"
	},
	"supports": {
		"html": false,
		"align": [ "left", "center", "right" ],
		"anchor": true,
		"layout": {
			"allowSwitching": false,
			"allowInheriting": false,
			"allowVerticalAlignment": false,
			"default": {
				"type": "flex"
			}
		},
		"spacing": {
			"blockGap": [ "horizontal", "vertical" ],
			"margin": true,
			"padding": true,
			"units": [ "px", "em", "rem", "vh", "vw" ],
			"__experimentalDefaultControls": {
				"blockGap": true,
				"margin": true,
				"padding": false
			}
		}
	},
	"styles": [
		{ "name": "default", "label": "Default", "isDefault": true },
		{ "name": "logos-only", "label": "Logos Only" },
		{ "name": "pill-shape", "label": "Pill Shape" }
	],
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
