{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "740px",
			"wideSize": "1260px"
		}
	},
	"styles": {
		"elements": {
			"button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-alt)",
						"text": "var(--wp--preset--color--primary-alt-accent)"
					},
					"typography": {
						"textDecoration": "none"
					}
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--primary-alt-accent)"
				},
				"typography": {
					"fontWeight": "600"
				}
			}
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--medium)",
			"padding": {
				"bottom": "0",
				"left": "var(--wp--preset--spacing--medium)",
				"right": "var(--wp--preset--spacing--medium)",
				"top": "0"
			}
		}
	}
}