{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#e6b6b6",
					"name": "Brand",
					"slug": "primary"
				},
				{
					"color": "#f6f0f0",
					"name": "Brand Accent",
					"slug": "primary-accent"
				},
				{
					"color": "#e99696",
					"name": "Brand Alt",
					"slug": "primary-alt"
				},
				{
					"color": "#452121",
					"name": "Brand Alt Accent",
					"slug": "primary-alt-accent"
				},
				{
					"color": "#231515",
					"name": "Contrast",
					"slug": "main"
				},
				{
					"color": "#dec9c9",
					"name": "Contrast Accent",
					"slug": "main-accent"
				},
				{
					"color": "#ffffff",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#6d3b3b",
					"name": "Base Accent",
					"slug": "secondary"
				},
				{
					"color": "#f8f7f7",
					"name": "Tint",
					"slug": "tertiary"
				},
				{
					"color": "#e3d9d9",
					"name": "Border Base",
					"slug": "border-light"
				},
				{
					"color": "#663d3d",
					"name": "Border Contrast",
					"slug": "border-dark"
				},
				{
					"color": "#5a9367",
					"name": "Go",
					"slug": "custom-go"
				},
				{
					"color": "#c15a67",
					"name": "Stop",
					"slug": "custom-stop"
				}
			]
		},
		"layout": {
			"contentSize": "740px",
			"wideSize": "1260px"
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontDisplay": "swap",
							"fontFamily": "\"Nunito Sans\"",
							"fontStyle": "normal",
							"fontWeight": "200 1000",
							"src": [
								"file:./assets/fonts/nunito-sans/nunito-sans-normal.woff2"
							]
						},
						{
							"fontDisplay": "swap",
							"fontFamily": "\"Nunito Sans\"",
							"fontStyle": "italic",
							"fontWeight": "200 1000",
							"src": [
								"file:./assets/fonts/nunito-sans/nunito-sans-italic.woff2"
							]
						}
					],
					"fontFamily": "\"Nunito Sans\", sans-serif",
					"name": "Nunito Sans",
					"slug": "nunito-sans"
				},
				{
					"fontFace": [
						{
							"fontDisplay": "swap",
							"fontFamily": "\"Tenor Sans\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/tenor-sans/tenor-sans-normal.woff2"
							]
						}
					],
					"fontFamily": "\"Tenor Sans\", sans-serif",
					"name": "Tenor Sans",
					"slug": "tenor-sans"
				}
			],
			"fontSizes": [
				{
					"fluid": {
						"max": ".95rem",
						"min": ".825rem"
					},
					"name": "Extra Small",
					"size": ".95rem",
					"slug": "x-small"
				},
				{
					"fluid": {
						"max": "1.05rem",
						"min": ".9rem"
					},
					"name": "Small",
					"size": "1.05rem",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "1.165rem",
						"min": "1rem"
					},
					"name": "Base",
					"size": "1.165rem",
					"slug": "base"
				},
				{
					"fluid": {
						"max": "1.65rem",
						"min": "1.2rem"
					},
					"name": "Medium",
					"size": "1.65rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "2.35rem",
						"min": "1.5rem"
					},
					"name": "Large",
					"size": "2.35rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "2.9rem",
						"min": "1.875rem"
					},
					"name": "Extra Large",
					"size": "2.9rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "3.75rem",
						"min": "2.25rem"
					},
					"name": "Extra Extra Large",
					"size": "3.75rem",
					"slug": "xx-large"
				},
				{
					"fluid": {
						"max": "1.3rem",
						"min": "1.1rem"
					},
					"name": "Base-Medium",
					"size": "1.3rem",
					"slug": "custom-1"
				},
				{
					"fluid": {
						"max": "4.5rem",
						"min": "2.5rem"
					},
					"name": "Jumbo",
					"size": "4.5rem",
					"slug": "custom-2"
				}
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--main-accent)",
						"text": "var(--wp--preset--color--primary-alt-accent)"
					},
					"typography": {
						"textDecoration": "none"
					}
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--primary-alt-accent)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--nunito-sans)",
					"fontStyle": "normal",
					"fontWeight": "400"
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--nunito-sans)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--tenor-sans)",
					"fontStyle": "normal",
					"fontWeight": "400"
				}
			},
			"link": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--nunito-sans)"
				}
			}
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--medium)",
			"padding": {
				"bottom": "0",
				"left": "var(--wp--preset--spacing--medium)",
				"right": "var(--wp--preset--spacing--medium)",
				"top": "0"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--nunito-sans)",
			"fontStyle": "normal",
			"fontWeight": "300"
		}
	}
}